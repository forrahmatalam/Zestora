# RIDER SERVICE
PORT=5005

# MONGODB CONNECTION
MONGODB_URI=your_mongodb_connection_string

# Use the same JWT secret as the auth service.
JWT_SECRET=replace_with_a_long_random_secret

# Backend service addresses
UTILS_SERVICE=http://localhost:5002
REALTIME_SERVICE=http://localhost:5004
RESTAURANT_SERVICE=http://localhost:5001

# Private key shared by backend services only. Never put this in frontend/.env.
INTERNAL_SERVICE_SECRET=replace_with_the_same_long_random_secret_in_backend_services

# RABBITMQ CONNECTION AND QUEUES
RABBITMQ_URL=amqp://localhost:5672
RIDER_QUEUE=rider_queue
ORDER_READY_QUEUE=order_ready_queue
