# UPLOADS AND RAZORPAY PAYMENT SERVICE
PORT=5002

# IMAGEKIT: Dashboard > Developer > API keys
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# RAZORPAY: Dashboard > Account & Settings > API Keys
# Use the Test keys while developing.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Backend service address
RESTAURANT_SERVICE=http://localhost:5001

# Private key shared by backend services only. Never put this in frontend/.env.
INTERNAL_SERVICE_SECRET=replace_with_the_same_long_random_secret_in_backend_services

# RABBITMQ CONNECTION AND PAYMENT QUEUE
RABBITMQ_URL=amqp://localhost:5672
PAYMENT_QUEUE=payment_event
