# GOOGLE LOGIN
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Add this exact origin under Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# BACKEND ADDRESSES (leave these defaults for local development)
VITE_AUTH_SERVICE_URL=http://localhost:5010
VITE_RESTAURANT_SERVICE_URL=http://localhost:5001
VITE_UTILS_SERVICE_URL=http://localhost:5002
VITE_REALTIME_SERVICE_URL=http://localhost:5004
VITE_RIDER_SERVICE_URL=http://localhost:5005
VITE_ADMIN_SERVICE_URL=http://localhost:5006

# Do not put secret keys in frontend/.env. VITE_ values are visible in the browser.
# Razorpay keys belong in services/utils/.env, not this file.
